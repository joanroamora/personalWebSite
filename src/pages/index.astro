---
import SiteLayout from '../layouts/SiteLayout.astro';
import { navigation } from '../data/navigation';
import { publicProfile, featuredProjects } from '../data/profile';
import TechnologyBadge from '../components/TechnologyBadge.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import { getBlogPosts } from '../data/blog';
import { postHref, projectHref, sectionHref, withBase } from '../utils/paths';
const [latestPost] = await getBlogPosts();
const [featured] = featuredProjects;
---

<SiteLayout title="Inicio">
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> {publicProfile.name}</p>
      <h1 id="intro-title">Ideas en<br /><em>órbita.</em></h1>
      <p class="lead">{publicProfile.introduction[0]}</p>
      <a class="text-link" href={sectionHref('about')}>Conocer este espacio <span aria-hidden="true">↗</span></a>
    </div>
    <div class="orbital" aria-hidden="true">
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="orbit orbit-three"></div>
      <div class="planet"></div>
      <span class="satellite"></span>
      <span class="orbital-caption">Una nueva órbita, por descubrir.</span>
    </div>
  </section>

  <section class="personal-note" aria-labelledby="personal-phrase-title">
    <p id="personal-phrase-title" class="eyebrow">Tecnología y personas</p>
    <p class="personal-perspective">{publicProfile.biography[1]}</p>
  </section>

  <section class="home-highlights divided-section" aria-labelledby="highlights-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Del archivo / Código y cuaderno</p>
        <h2 id="highlights-title">Algo que mirar.<br />Algo que leer.</h2>
      </div>
      <p class="muted">Proyectos propios, experimentos y un cuaderno que empieza a tomar forma.</p>
    </div>
    <div class="highlights-grid">
      <article class="featured-placeholder" aria-labelledby="featured-title">
        <div class="featured-orbit" aria-hidden="true"><span></span></div>
        <div class="highlight-copy">
          <p class="eyebrow">Proyecto destacado</p>
          <h3 id="featured-title">{featured.title}</h3>
          <p>{featured.personalSummary}</p>
          <ul class="home-technologies" aria-label={`Tecnologías de ${featured.title}`} role="list">{featured.technologies.map(technology => <li><TechnologyBadge name={technology} /></li>)}</ul>
          <a class="text-link" href={projectHref(featured.id)}>Descubrir el proyecto <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <article class="latest-placeholder" aria-labelledby="latest-title">
        <p class="eyebrow">Última entrada / El cuaderno</p>
        {latestPost ? <>
          <h3 id="latest-title">{latestPost.data.title}</h3>
          <p>{latestPost.data.summary}</p>
          <div style="margin-top:1.25rem"><PostMeta post={latestPost} /></div>
          <a class="text-link" href={postHref(latestPost.data.slug)}>Leer la entrada <span aria-hidden="true">↗</span></a>
        </> : <>
          <h3 id="latest-title">El cuaderno está abierto.</h3>
          <p>Las próximas notas y textos encontrarán aquí su lugar.</p>
          <a class="text-link" href={sectionHref('blog')}>Visitar el blog <span aria-hidden="true">↗</span></a>
        </>}
      </article>
    </div>
    <div class="games-invitation">
      <div><p class="eyebrow">Una pausa en el camino</p><h3>Un rato para jugar a Cadete Roa.</h3></div>
      <a class="text-link" href={sectionHref('games')}>Explorar juegos <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="por-explorar" class="explore" aria-labelledby="explore-title">
    <div class="section-intro">
      <p class="eyebrow">Por explorar</p>
      <h2 id="explore-title">Todo tiene<br />su órbita.</h2>
      <p class="muted">Código, juegos, textos y las historias que los conectan.</p>
    </div>
    <ol class="section-list">
      {navigation.slice(1).map((section, index) => (
        <li>
          <a class="section-entry" href={withBase(section.path)}>
            <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 id={`explore-section-${index}`}>{section.label}</h3>
              <p>{section.description}</p>
            </div>
            <span class="section-direction" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>
<style>
  .personal-perspective { margin-top:1.25rem; font:400 clamp(1.35rem,3vw,2rem)/1.5 var(--font-editorial); letter-spacing:-.02em; }
  .home-technologies { display:flex; flex-wrap:wrap; gap:.5rem; margin:1.4rem 0 0; padding:0; list-style:none; }
</style>
