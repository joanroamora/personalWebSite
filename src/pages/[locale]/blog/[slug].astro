---
import Page from '../../blog/[slug].astro';
import { translatedLocales } from '../../../i18n/locales';
import { getBlogPosts } from '../../../data/blog';
export async function getStaticPaths() {
  const posts=await getBlogPosts();
  return translatedLocales.flatMap(locale=>posts.map((post,index)=>({params:{locale:locale.code,slug:post.data.slug},props:{post,newer:posts[index-1],older:posts[index+1]}})));
}
---
<Page {...Astro.props} />
