---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import { projects, type Project } from '../../data/projects';
import { sectionHref } from '../../utils/paths';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
---
<SiteLayout title={project.title} description={project.summary}>
  <div class="project-page">
    <a class="text-link" href={sectionHref('projects')}><span aria-hidden="true">←</span> Volver a proyectos</a>
    <div class="standalone-detail"><ProjectDetails project={project} standalone /></div>
  </div>
</SiteLayout>
<style>
  .project-page { max-width: 48rem; margin-inline: auto; padding-block: 1.5rem 4rem; }
  .project-page > .text-link { margin-bottom: 2rem; }
  .standalone-detail { border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); }
</style>
