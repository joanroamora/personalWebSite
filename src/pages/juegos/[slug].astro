---
import SiteLayout from '../../layouts/SiteLayout.astro';
import GameArtwork from '../../components/GameArtwork.astro';
import { games, type Game } from '../../data/games';
import { sectionHref } from '../../utils/paths';
export function getStaticPaths() { return games.filter(game => game.status === 'development').map(game => ({ params:{slug:game.id}, props:{game} })); }
interface Props { game: Game }
const { game } = Astro.props;
---
<SiteLayout title={game.title} description={game.summary}>
  <section class="section-page game-placeholder" aria-labelledby="game-title">
    <a class="back-link" href={sectionHref('games')}>← Volver a Juegos</a>
    <div class="concept-art"><GameArtwork game={game} /></div>
    <p class="eyebrow">En desarrollo · Ficha de muestra</p>
    <h1 id="game-title" class="page-title">{game.title}</h1>
    <p class="concept-subtitle">{game.subtitle}</p><p class="concept-summary">{game.summary}</p>
    <div class="concept-note"><h2>Una idea tomando forma.</h2>{game.instructions.map(instruction => <p>{instruction}</p>)}<a class="text-link" href={sectionHref('games')}>Explorar el arcade <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
<style>
  .game-placeholder { max-width:50rem; margin-inline:auto; }.back-link { display:inline-flex;min-height:2.75rem;align-items:center;font-size:.8rem;color:var(--muted);margin-bottom:2rem;text-decoration:none; }
  .concept-art { border:1px solid var(--line);border-radius:.8rem;overflow:hidden;margin-bottom:2rem; }.concept-art :global(.game-art) { height:16rem; }
  .page-title { font-size:clamp(2.5rem,7vw,4.5rem);margin-block:1rem; }.concept-subtitle { color:var(--cyan);font-size:1.1rem; }.concept-summary { color:var(--muted);margin-top:1rem;max-width:38rem; }
  .concept-note { padding:2rem;border:1px solid var(--line);border-radius:.8rem;background:var(--surface);margin-top:2.5rem; }.concept-note h2 { margin:0 0 1rem;font-size:1.6rem; }.concept-note p { color:var(--muted);font-size:.9rem; }
</style>
