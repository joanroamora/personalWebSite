---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import BlogContent from '../../components/blog/BlogContent.astro';
import { getBlogPosts } from '../../data/blog';
const posts = await getBlogPosts();
const hasDemo = posts.length>0 && posts.every(post => post.data.status === 'demo');
---
<SiteLayout title="Blog" description="Un cuaderno para detenerse en una idea: notas sobre código, juegos y el impulso de crear.">
  <section class="section-page" aria-labelledby="section-title">
    <PageIntro title="Blog" description="Notas desde esta órbita. Sobre las cosas que hacemos, las preguntas que quedan y el gusto de seguir explorando." position={4} state={hasDemo ? 'Cuaderno de muestra' : 'Cuaderno abierto'} />
    {hasDemo && <DemoNotice text="Cuaderno de demostración. Estos textos y sus fechas son de muestra; no representan publicaciones ni experiencias del propietario." />}
    <BlogContent posts={posts} />
  </section>
</SiteLayout>
