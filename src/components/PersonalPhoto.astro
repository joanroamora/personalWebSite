---
import { Picture } from 'astro:assets';
import { personalPhotos, type PersonalPhotoId } from '../data/photos';

interface Props {
  photo: PersonalPhotoId;
  variant?: 'portrait' | 'landscape';
  priority?: boolean;
  sizes?: string;
}

const { photo: id, variant = 'portrait', priority = false, sizes = '(min-width: 45rem) 22rem, calc(100vw - 2.5rem)' } = Astro.props;
const photo = personalPhotos[id];
---

<figure class:list={['personal-photo', `personal-photo--${variant}`]} data-personal-photo={id} style={`--photo-position: ${photo.position}`}>
  <div class="personal-photo-frame">
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={['webp']}
      fallbackFormat="jpg"
      width={960}
      widths={[320, 480, 720, 960]}
      sizes={sizes}
      quality={80}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  <figcaption>{photo.caption}</figcaption>
</figure>

<style>
  .personal-photo { margin:0; min-width:0; width:100%; }
  .personal-photo-frame { position:relative; aspect-ratio:4 / 5; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); }
  .personal-photo--landscape .personal-photo-frame { aspect-ratio:4 / 3; }
  .personal-photo-frame :global(picture) { display:block; height:100%; }
  .personal-photo-frame :global(img) { display:block; width:100%; height:100%; object-fit:cover; object-position:var(--photo-position); }
  figcaption { padding-block-start:.85rem; color:var(--muted); font:400 .7rem/1.6 var(--font-mono); }
</style>
