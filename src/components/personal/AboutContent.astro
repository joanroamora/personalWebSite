---
import { personalDemo } from '../../data/personal-demo';
import { sectionHref } from '../../utils/paths';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
const { about } = personalDemo;
---

<div class="about-grid content-block">
  <section class="prose" aria-labelledby="biography-title">
    <p class="eyebrow">Biografía de muestra</p>
    <h2 id="biography-title">{about.title}</h2>
    {about.biography.map(paragraph => <p>{paragraph}</p>)}
  </section>
  <PhotoPlaceholder />
</div>

<section class="content-block divided-section" aria-labelledby="interests-title">
  <p class="eyebrow">Intereses de muestra</p>
  <h2 id="interests-title">Tres maneras de explorar.</h2>
  <ul class="interest-list">
    {about.interests.map((interest, index) => (
      <li>
        <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{interest.title}</h3>
        <p>{interest.description}</p>
      </li>
    ))}
  </ul>
</section>

<section class="approach-block divided-section" aria-labelledby="approach-title">
  <div>
    <p class="eyebrow">Enfoque creativo de muestra</p>
    <h2 id="approach-title">Hacer espacio a lo posible.</h2>
  </div>
  <div class="prose">
    <p>{about.approach}</p>
    <a class="text-link" href={sectionHref('journey')}>Explorar la trayectoria <span aria-hidden="true">↗</span></a>
  </div>
</section>
