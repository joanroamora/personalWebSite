---
import { publicProfile } from '../../data/profile';
import { sectionHref } from '../../utils/paths';
import PersonalPhoto from '../PersonalPhoto.astro';
import TechnologyBadge from '../TechnologyBadge.astro';
import '../../styles/profile.css';
const { biography, practice, applications, technologies } = publicProfile;
const practiceTitles = ['Infraestructura y entrega', 'Confiabilidad y observabilidad', 'Proyectos propios e inteligencia artificial'];
---

<div class="about-grid content-block">
  <section class="prose" aria-labelledby="biography-title">
    <p class="eyebrow">La persona detrás del archivo</p>
    <h2 id="biography-title">Tecnología con una mirada humana.</h2>
    {biography.map(paragraph => <p>{paragraph}</p>)}
  </section>
  <aside class="profile-sidebar" aria-label="Un poco más de contexto">
    <div class="profile-portrait"><PersonalPhoto photo="portrait" priority /></div>
    <div class="profile-location"><p class="eyebrow">Desde aquí</p><p>{publicProfile.contact.location}</p><a class="text-link" href={sectionHref('contact')}>Cruzar una señal <span aria-hidden="true">↗</span></a></div>
  </aside>
</div>

<section class="content-block divided-section" aria-labelledby="interests-title">
  <p class="eyebrow">Lo que hago</p>
  <h2 id="interests-title">De la infraestructura a las ideas.</h2>
  <ul class="interest-list">
    {practice.map((paragraph, index) => (
      <li>
        <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{practiceTitles[index] ?? 'Otra forma de explorar'}</h3>
        <p>{paragraph}</p>
      </li>
    ))}
  </ul>
</section>

<section class="content-block divided-section" aria-labelledby="applications-title">
  <p class="eyebrow">Ámbitos de aplicación</p>
  <h2 id="applications-title">Distintos contextos. Nuevas preguntas.</h2>
  <ul class="profile-applications" role="list">{applications.map(application => <li>{application}</li>)}</ul>
</section>

<section class="content-block divided-section" aria-labelledby="technologies-title">
  <p class="eyebrow">Herramientas que acompañan el proceso</p>
  <h2 id="technologies-title">Con qué construyo.</h2>
  <dl class="profile-toolkit">{technologies.map(({ area, tools }) => <div><dt>{area}</dt><dd><ul role="list">{tools.map(tool => <li><TechnologyBadge name={tool} /></li>)}</ul></dd></div>)}</dl>
</section>

<section class="approach-block divided-section" aria-labelledby="approach-title">
  <div>
    <p class="eyebrow">Seguir aprendiendo</p>
    <h2 id="approach-title">Una pregunta lleva a la siguiente.</h2>
  </div>
  <div class="prose">
    <p>{publicProfile.introduction[1]}</p>
    <a class="text-link" href={sectionHref('journey')}>Explorar la trayectoria <span aria-hidden="true">↗</span></a>
  </div>
</section>
