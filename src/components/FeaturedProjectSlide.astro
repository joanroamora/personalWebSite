---
import type { Project } from '../data/projects';
import { projectHref } from '../utils/paths';
import ProjectArtwork from './ProjectArtwork.astro';
import TechnologyBadge from './TechnologyBadge.astro';
interface Props { project: Project; summary?: string; }
const { project, summary = project.summary } = Astro.props;
---
<div class="featured-slide" data-featured-slide={project.id}>
  <ProjectArtwork project={project} variant="featured" />
  <div class="highlight-copy">
    <p class="eyebrow">Proyecto destacado</p>
    <h3 id="featured-title">{project.title}</h3>
    <p>{summary}</p>
    <ul class="home-technologies" aria-label={`Tecnologías de ${project.title}`} role="list">
      {project.technologies.map(technology => <li><TechnologyBadge name={technology} /></li>)}
    </ul>
    <a class="text-link" href={projectHref(project.id)}>Descubrir el proyecto <span aria-hidden="true">↗</span></a>
  </div>
</div>
<style>
  .featured-slide { min-width:0; }
  .home-technologies { display:flex; flex-wrap:wrap; gap:.5rem; margin:1.4rem 0; padding:0; list-style:none; }
  .highlight-copy { display:flex; flex-direction:column; align-items:flex-start; }
  .highlight-copy > .text-link { margin-top:auto; }
  .highlight-copy { min-height:31rem; }
  @media (min-width:45rem) { .highlight-copy { min-height:26rem; } }
</style>
