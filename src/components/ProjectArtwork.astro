---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import { routeContext } from '../i18n/locales';
import { translate } from '../i18n/render';

interface Props { project: Project; variant?: 'card' | 'detail' | 'featured'; }
const { project, variant = 'card' } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.webp', { eager: true });
const source = sources[`../assets/projects/${project.id}.webp`]?.default;
if (!source) throw new Error(`Falta la ilustración aprobada del proyecto ${project.id}.`);
const { locale } = routeContext(Astro.url.pathname, import.meta.env.BASE_URL);
const prefix = {
  es: 'Plano conceptual en tinta sepia para', en: 'Conceptual sepia engineering drawing for',
  zh: '棕褐色墨水概念工程图：', hi: 'सेपिया स्याही में वैचारिक इंजीनियरिंग चित्र:',
  ar: 'رسم هندسي تصوري بحبر بني لمشروع', fr: 'Dessin technique conceptuel à l’encre sépia pour',
}[locale];
const sizes = variant === 'detail' ? '(min-width: 45rem) 38rem, calc(100vw - 5rem)'
  : variant === 'featured' ? '(min-width: 74rem) 37rem, (min-width: 45rem) 55vw, calc(100vw - 2.5rem)'
  : '(min-width: 74rem) 21rem, (min-width: 45rem) 45vw, calc(100vw - 2.5rem)';
---
<figure class:list={['project-artwork', `artwork-${variant}`]} data-project-artwork={project.id}>
  <Picture src={source} alt={`${prefix} ${translate(project.title, locale)}.`} formats={['webp']} fallbackFormat="jpg"
    widths={[360, 600, 900, 1200]} width={1200} sizes={sizes} quality={80} loading="lazy" decoding="async" />
  {variant === 'detail' && <figcaption>Ilustración conceptual · Generada con IA</figcaption>}
</figure>
<style>
  .project-artwork { margin:0; width:100%; min-width:0; }
  .project-artwork :global(picture) { display:block; overflow:hidden; aspect-ratio:3/2; background:#cfb68b; }
  .project-artwork :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .artwork-card :global(picture), .artwork-featured :global(picture) { border-radius:var(--radius) var(--radius) 0 0; }
  .artwork-detail { margin-block:1.75rem 2rem; }
  .artwork-detail :global(picture) { border:1px solid #d4b68044; border-radius:.65rem; }
  figcaption { margin-top:.65rem; color:var(--muted); font:.6rem/1.6 var(--font-mono); }
</style>
