---
import { technologyIcons, technologyGlyph } from '../data/technology-icons';
import { withBase } from '../utils/paths';
interface Props { name: string; }
const { name } = Astro.props;
const icon = technologyIcons[name];
const glyphs = {
  code: 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  data: 'M20 6c0 2-16 2-16 0s16-2 16 0v12c0 3-16 3-16 0V6m0 6c0 3 16 3 16 0',
  audio: 'M4 9v6m4-10v14m4-11v8m4-13v18m4-12v6',
  scan: 'M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5M7 9h10M7 13h10M7 17h5',
  model: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z',
  flow: 'M5 5h14v5H5zM5 15h5v5H5zm9 0h5v5h-5zM12 10v3M7.5 15v-2h9v2',
};
---
<span class="technology-badge">
  {icon ? <img class:list={['technology-icon', { monochrome: icon.monochrome }]} src={withBase(`icons/technologies/${icon.file}.svg`)} width="16" height="16" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    : <svg class="technology-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={glyphs[technologyGlyph(name)]} /></svg>}
  <span>{name}</span>
</span>
<style>
  .technology-badge { display: inline-flex; align-items: center; gap: 0.4rem; max-width: 100%; padding: 0.38rem 0.58rem; border: 1px solid #2b3a37; border-radius: 0.4rem; background: #14211c66; font-size: 0.7rem; line-height: 1.3; color: #c4d1c8; }
  .technology-badge > span { min-width: 0; }
  .technology-icon { display: block; flex: 0 0 16px; width: 16px; height: 16px; object-fit: contain; color: var(--cyan); }
  .monochrome { filter: brightness(0) invert(0.88); }
</style>
