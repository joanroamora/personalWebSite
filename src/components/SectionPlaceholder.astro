---
import { withBase } from '../utils/paths';
import type { navigation } from '../data/navigation';
import PageIntro from './PageIntro.astro';

interface Props {
  section: (typeof navigation)[number];
  position: number;
}

const { section, position } = Astro.props;
---

<section class="section-page" aria-labelledby="section-title">
  <PageIntro title={section.label} description={section.description} position={position} state="En preparación" />
  <div class="placeholder-panel">
    <div class="placeholder-symbol" aria-hidden="true"><span></span></div>
    <div class="placeholder-copy">
      <p class="eyebrow">Espacio reservado</p>
      <h2>Esta sección está tomando forma.</h2>
      <p>Contenido de demostración. Aquí aparecerán nuevas ideas y contenidos más adelante.</p>
      <a class="text-link" href={withBase()}>Volver al inicio <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
