---
import type { Game } from '../data/games';
interface Props { game: Game }
const { game } = Astro.props;
---
<div class:list={['game-art', `art-${game.symbol}`]} aria-hidden="true">
  {game.symbol === 'cadet' ? (
    <svg viewBox="0 0 800 520" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs><linearGradient id={`sky-${game.id}`} x2="0" y2="1"><stop stop-color="#7e978b"/><stop offset="1" stop-color="#c4b898"/></linearGradient></defs>
      <path fill={`url(#sky-${game.id})`} d="M0 0h800v520H0z"/>
      <circle cx="608" cy="100" r="40" fill="#ded2a5" opacity=".8"/>
      <path d="m0 220 90-125 100 93 90-59 116 107 110-103 100 73 96-58 98 89v283H0Z" fill="#73816a"/>
      <path d="m0 265 131-71 92 59 135-35 134 42 126-54 182 74v240H0Z" fill="#979274"/>
      <path d="m347 228 92 0 239 292H94Z" fill="#796e53"/>
      <path d="m346 228-5 0L75 520h18Zm93 0h4l255 292h-20Z" fill="#c1b18a"/>
      <path d="m376 249-7 27m-9 27-14 40m-15 44-29 83m107-221 7 27m9 27 14 40m15 44 29 83" stroke="#c1b18a" stroke-width="3"/>
      <path d="m197 330 58-22 59 18-61 25Z" fill="#9bb3a0"/><path d="m197 330 56 21v68l-56-34Z" fill="#577e74"/><path d="m253 351 61-25v57l-61 36Z" fill="#3f665f"/>
      <path d="m209 341 0 40m16-31v42m48-40v46m18-54v44" stroke="#bdd1b1" opacity=".45" stroke-width="3"/>
      <path d="m485 369 60-20 69 39-61 27Z" fill="#59634a"/><path d="m485 369 0 28 68 42v-24Z" fill="#303b34"/><path d="m553 415 61-27v24l-61 27Z" fill="#222e2a"/>
      <path d="m505 358 37-14 43 24-40 17Z" fill="#829065"/><path d="m505 358 40 27v20l-40-25Z" fill="#62724d"/><path d="m545 385 40-17v18l-40 19Z" fill="#4c5c40"/>
      <path d="m533 364-53-30 5-8 58 31Z" fill="#303e37"/>
      <path d="m352 340 51-16 49 16-49 21Z" fill="#35443b"/><path d="m352 340 51 21v68l-51-30Z" fill="#68784d"/><path d="m403 361 49-21v69l-49 20Z" fill="#4a603f"/>
      <path d="m362 369 33 15v42l-33-16Z" fill="#a58f69"/><path d="m395 384 16-5v41l-16 6Z" fill="#7d7356"/>
      <path d="m360 397-17 39 25 10 20-38m30-3 18 39-23 16-20-40" stroke="#526641" stroke-width="19"/>
      <path d="m341 435 26 10-11 17-30-11Zm72 25 23-16 19 13-29 21Z" fill="#2e3932"/>
      <path d="m347 350-19 37 4 26m115-56 15 20 2 26" stroke="#63764d" stroke-width="17"/>
      <path d="m328 407 6 9m130-16 2 10" stroke="#b7926e" stroke-width="13"/>
      <path d="m373 302 29-10 31 14-3 35-27 12-30-13Z" fill="#a98b65"/>
      <path d="m364 303 39-28 40 28-6 19-34 13-39-15Z" fill="#6d8051"/><path d="m364 303 39 14 40-14-40-28Z" fill="#899666"/>
      <path d="m364 320 39 15v-18l-39-14Z" fill="#4c623f"/>
      <path d="m437 359 9 5v13l-9-4Z" fill="#efb780"/>
      <path d="m19 303 68-17 28 34-75 26Zm659 53 80-35 42 31v92l-74-28Z" fill="#687453"/>
      <path d="m48 316 42-10m624 54 39-17" stroke="#b2ad85" stroke-width="9"/>
      <path d="M28 27h24m-24 0v24m744-24h-24m24 0v24M28 493h24m-24 0v-24m744 24h-24m24 0v-24" stroke="#e9e9c5" opacity=".5"/>
    </svg>
  ) : (
    <svg viewBox="0 0 400 260" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="200" cy="130" r="85" opacity=".12"/>
      {game.symbol === 'orbit' && <><ellipse cx="200" cy="130" rx="104" ry="37" transform="rotate(-26 200 130)" opacity=".6"/><circle cx="200" cy="130" r="33" fill="currentColor" fill-opacity=".06"/><circle cx="286" cy="83" r="5" fill="currentColor"/><circle cx="200" cy="130" r="56" opacity=".2"/></>}
      {game.symbol === 'signal' && <><path d="m112 141 21-1 14-32 16 57 16-92 21 115 18-87 15 53 15-22h40"/><circle cx="200" cy="130" r="58" opacity=".18"/><path d="M93 180h45m124-100h45" opacity=".3"/></>}
      {game.symbol === 'garden' && <><path d="M200 185v-69m0 32c-38 0-49-22-49-42 34 0 49 17 49 42Zm0-15c0-37 23-55 49-55 0 35-16 55-49 55Z"/><ellipse cx="200" cy="190" rx="64" ry="12" opacity=".35"/><circle cx="252" cy="67" r="5" fill="currentColor" fill-opacity=".5"/></>}
      <path d="M28 28h12m-12 0v12m344-12h-12m12 0v12M28 232h12m-12 0v-12m344 12h-12m12 0v-12" opacity=".3"/>
    </svg>
  )}
</div>
<style>
  .game-art { width:100%; overflow:hidden; background:#101c1c; }
  svg { display:block; width:100%; height:100%; }
  .art-cadet { background:#8f9c83; }
  .art-orbit { color:#a7e88b; background:radial-gradient(ellipse at 50% 90%,#1c3027,#101a18 75%); }
  .art-signal { color:#83c7c5; background:radial-gradient(ellipse at 50% 90%,#193032,#101a1d 75%); }
  .art-garden { color:#bcb0da; background:radial-gradient(ellipse at 50% 90%,#292737,#17171e 75%); }
</style>
