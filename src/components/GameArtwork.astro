---
import type { Game } from '../data/games';
interface Props { game: Game }
const { game } = Astro.props;
---
<div class:list={['game-art', `art-${game.symbol}`]} aria-hidden="true">
  {game.symbol === 'cadet' ? (
    <svg viewBox="0 0 800 520" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs><linearGradient id={`sky-${game.id}`} x2="0" y2="1"><stop stop-color="#7e978b"/><stop offset="1" stop-color="#c4b898"/></linearGradient></defs>
      <path fill={`url(#sky-${game.id})`} d="M0 0h800v520H0z"/>
      <circle cx="608" cy="100" r="40" fill="#ded2a5" opacity=".8"/>
      <path d="m0 220 90-125 100 93 90-59 116 107 110-103 100 73 96-58 98 89v283H0Z" fill="#73816a"/>
      <path d="m0 265 131-71 92 59 135-35 134 42 126-54 182 74v240H0Z" fill="#979274"/>
      <path d="m347 228 92 0 239 292H94Z" fill="#796e53"/>
      <path d="m346 228-5 0L75 520h18Zm93 0h4l255 292h-20Z" fill="#c1b18a"/>
      <path d="m376 249-7 27m-9 27-14 40m-15 44-29 83m107-221 7 27m9 27 14 40m15 44 29 83" stroke="#c1b18a" stroke-width="3"/>
      <path d="m197 330 58-22 59 18-61 25Z" fill="#9bb3a0"/><path d="m197 330 56 21v68l-56-34Z" fill="#577e74"/><path d="m253 351 61-25v57l-61 36Z" fill="#3f665f"/>
      <path d="m209 341 0 40m16-31v42m48-40v46m18-54v44" stroke="#bdd1b1" opacity=".45" stroke-width="3"/>
      <path d="m485 369 60-20 69 39-61 27Z" fill="#59634a"/><path d="m485 369 0 28 68 42v-24Z" fill="#303b34"/><path d="m553 415 61-27v24l-61 27Z" fill="#222e2a"/>
      <path d="m505 358 37-14 43 24-40 17Z" fill="#829065"/><path d="m505 358 40 27v20l-40-25Z" fill="#62724d"/><path d="m545 385 40-17v18l-40 19Z" fill="#4c5c40"/>
      <path d="m533 364-53-30 5-8 58 31Z" fill="#303e37"/>
      <path d="m352 340 51-16 49 16-49 21Z" fill="#35443b"/><path d="m352 340 51 21v68l-51-30Z" fill="#68784d"/><path d="m403 361 49-21v69l-49 20Z" fill="#4a603f"/>
      <path d="m362 369 33 15v42l-33-16Z" fill="#a58f69"/><path d="m395 384 16-5v41l-16 6Z" fill="#7d7356"/>
      <path d="m360 397-17 39 25 10 20-38m30-3 18 39-23 16-20-40" stroke="#526641" stroke-width="19"/>
      <path d="m341 435 26 10-11 17-30-11Zm72 25 23-16 19 13-29 21Z" fill="#2e3932"/>
      <path d="m347 350-19 37 4 26m115-56 15 20 2 26" stroke="#63764d" stroke-width="17"/>
      <path d="m328 407 6 9m130-16 2 10" stroke="#b7926e" stroke-width="13"/>
      <path d="m373 302 29-10 31 14-3 35-27 12-30-13Z" fill="#a98b65"/>
      <path d="m364 303 39-28 40 28-6 19-34 13-39-15Z" fill="#6d8051"/><path d="m364 303 39 14 40-14-40-28Z" fill="#899666"/>
      <path d="m364 320 39 15v-18l-39-14Z" fill="#4c623f"/>
      <path d="m437 359 9 5v13l-9-4Z" fill="#efb780"/>
      <path d="m19 303 68-17 28 34-75 26Zm659 53 80-35 42 31v92l-74-28Z" fill="#687453"/>
      <path d="m48 316 42-10m624 54 39-17" stroke="#b2ad85" stroke-width="9"/>
      <path d="M28 27h24m-24 0v24m744-24h-24m24 0v24M28 493h24m-24 0v-24m744 24h-24m24 0v-24" stroke="#e9e9c5" opacity=".5"/>
    </svg>
  ) : game.symbol === 'galactian' ? (
    <svg viewBox="0 0 600 360" fill="none" preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges">
      <path fill="#263f3c" d="M0 0h600v360H0z"/><path fill="#354c42" d="M50 0h110v90H50zM400 0h130v100H400zM12 190h110v170H12zM430 210h140v150H430z"/><path fill="#647058" d="M275 0h50v360h-50z"/>
      {[30,90,150,210,270,330].map(y=><path fill="#9c9e72" d={`M298 ${y}h4v22h-4z`} />)}
      <path stroke="#739167" stroke-width="8" d="M99 151h40v33H99zM450 135h47v36h-47z"/><path fill="#112b32" stroke="#80bc9e" stroke-width="3" d="M61 240h102v89H61z"/><path stroke="#b7e6be" stroke-width="3" d="M91 263v44m37-44v44m-37-22h37"/>
      {[{x:204,y:76},{x:389,y:103},{x:236,y:147}].map(({x,y})=><g transform={`translate(${x} ${y})`}><path fill="#c99a6e" d="m0-17 8 14 16 17-19-5-5 6-5-6-19 5 16-17z"/><path fill="#ef8c72" d="M-3-8h6v15h-6z"/><path fill="#ffc589" d="M-2 27h4v14h-4z"/></g>)}
      <g transform="translate(309 255) scale(1.8)"><path fill="#a4c9d3" d="m0-23 7 17 17 19v7L5 12l-5 7-5-7-19 8v-7L-7-6z"/><path fill="#ecf0ca" d="M-3-17h6v31h-6z"/><path fill="#62e5d5" d="M-2-10h4V1h-4z"/><path fill="#ffc785" d="M-3 20h6v13h-6z"/></g>
      <path stroke="#c5ec92" stroke-width="4" d="M299 185v-19m20 19v-19m-20-22v-19m20 19v-19"/><path fill="#152d37cc" d="M0 0h600v46H0z"/><path stroke="#b6d39a" stroke-width="2" d="M22 65h17m-17 0v17m556-17h-17m17 0v17M22 338h17m-17 0v-17m556 17h-17m17 0v-17"/>
    </svg>
  ) : game.symbol === 'bike' ? (
    <svg viewBox="0 0 600 360" fill="none" preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges">
      <path fill="#182039" d="M0 0h600v360H0z"/><path fill="#34355b" d="M0 152h88v-24h60v-31h55v31h56v28h84v-49h66v-31h43v50h76v35h72v199H0z"/>
      <path fill="#ffce8b" d="M441 64h52v8h13v12h8v35h-8v12h-13v8h-52v-8h-13v-12h-8V84h8V72h13z"/>
      <path fill="#555071" d="M0 220h65v-18h75v-35h70v31h97v27h98v-39h69v-25h53v38h73v161H0z"/>
      <path fill="#513d42" d="M0 305h122v-12h22v-13h22v-15h22v-12h75v19h25v18h25v15h68v-55h30v-17h30v-17h30v-17h30v-17h79v178H0z"/>
      <path stroke="#f6d6a5" stroke-width="8" d="M0 303h122v-12h22v-13h22v-15h22v-12h75m50 52h68v-55h30v-17h30v-17h30v-17h30v-17h79"/>
      <g transform="translate(243 209) rotate(-18)">
        <path fill="#101b29" d="M-65-2h25v7h8v23h-8v8h-25v-8h-8V5h8zm91 0h25v7h8v23h-8v8H26v-8h-8V5h8z"/>
        <path fill="#e8e8ce" d="M-63 7h20v19h-20zm91 0h20v19H28z"/>
        <path stroke="#79d8ce" stroke-width="7" d="m-53 16 19-41 43 6-18 35h-44l33-30 58 30-10-48"/>
        <path stroke="#f19169" stroke-width="8" d="m-9 16 0-25 18-10"/><path stroke="#101b29" stroke-width="9" d="M-40-29h38"/>
        <path stroke="#f2efda" stroke-width="6" d="m17-36 11 4 10 48"/>
        <path stroke="#f19169" stroke-width="13" d="m-20-38 11-32"/><path stroke="#f2efda" stroke-width="6" d="m-8-67 14 21 20 11"/>
        <path stroke="#101b29" stroke-width="10" d="m-21-35 18 20-8 26"/>
        <path fill="#f2efda" d="M-17-96h23v6h6v23h-29v-6h-6v-17h6z"/><path fill="#79d8ce" d="M-17-96H6v6h-23z"/><path fill="#101b29" d="M-2-85h18v9H-2z"/>
      </g>
      <path stroke="#ffc98a" stroke-width="4" d="m73 254 36-12m-29 27 24-8m269-63 14-6"/><path fill="#182039aa" d="M0 0h600v45H0z"/>
    </svg>
  ) : game.symbol === 'crane' ? (
    <svg viewBox="0 0 600 360" fill="none" preserveAspectRatio="xMidYMid slice">
      <path fill="#718e9d" d="M0 0h600v360H0z"/><path fill="#9eafa9" d="M0 157h600v203H0z"/><path fill="#456473" d="M22 105h85v79H22zM119 89h102v95H119zM415 79h135v105H415z"/><path fill="#cec7aa" d="M0 213h600v147H0z"/>
      <path stroke="#334c5c" stroke-width="12" d="M30 52v235m537-235v235M0 62h600"/><path stroke="#edc38d" stroke-width="18" d="M0 45h600"/><path stroke="#69736b" stroke-width="4" d="M0 305h600M0 326h600"/>
      {[60,165,270,375,480].map((x,i)=><g><path fill="#344f60" d={`M${x-42} 285h84v17h-84z`}/><circle cx={x-25} cy="312" r="9" fill="#243b49"/><circle cx={x+25} cy="312" r="9" fill="#243b49"/>{i!==2&&<path fill={i%2?'#a2bd9b':'#70acc8'} d={`M${x-34} 244h68v40h-68z`} />}</g>)}
      <path fill="#f2ca90" d="M242 39h57v30h-57z"/><path stroke="#273f4e" stroke-width="3" d="M255 69v98m30-98v98"/><path fill="#ecbd7c" d="M239 164h63v9h-63z"/><path fill="#d6a970" d="M237 175h68v42h-68z"/><path stroke="#8a775a" stroke-width="2" d="M248 179v33m11-33v33m11-33v33m11-33v33m11-33v33"/><path fill="#1c3545" d="M247 186h48v15h-48z"/><text x="271" y="197" text-anchor="middle" fill="#eee8d4" font-size="9" font-family="monospace">C-12 ◆</text><path stroke="#ffeeaf" stroke-dasharray="6 4" stroke-width="2" d="M237 244h68v40h-68z"/><text x="271" y="347" text-anchor="middle" fill="#2e4853" font-size="11" font-family="monospace">SLOT 03</text>
    </svg>
  ) : (
    <svg viewBox="0 0 400 260" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="200" cy="130" r="85" opacity=".12"/>
      {game.symbol === 'orbit' && <><ellipse cx="200" cy="130" rx="104" ry="37" transform="rotate(-26 200 130)" opacity=".6"/><circle cx="200" cy="130" r="33" fill="currentColor" fill-opacity=".06"/><circle cx="286" cy="83" r="5" fill="currentColor"/><circle cx="200" cy="130" r="56" opacity=".2"/></>}
      {game.symbol === 'signal' && <><path d="m112 141 21-1 14-32 16 57 16-92 21 115 18-87 15 53 15-22h40"/><circle cx="200" cy="130" r="58" opacity=".18"/><path d="M93 180h45m124-100h45" opacity=".3"/></>}
      {game.symbol === 'garden' && <><path d="M200 185v-69m0 32c-38 0-49-22-49-42 34 0 49 17 49 42Zm0-15c0-37 23-55 49-55 0 35-16 55-49 55Z"/><ellipse cx="200" cy="190" rx="64" ry="12" opacity=".35"/><circle cx="252" cy="67" r="5" fill="currentColor" fill-opacity=".5"/></>}
      <path d="M28 28h12m-12 0v12m344-12h-12m12 0v12M28 232h12m-12 0v-12m344 12h-12m12 0v-12" opacity=".3"/>
    </svg>
  )}
</div>
<style>
  .game-art { width:100%; overflow:hidden; background:#101c1c; }
  svg { display:block; width:100%; height:100%; }
  .art-cadet { background:#8f9c83; }
  .art-orbit { color:#a7e88b; background:radial-gradient(ellipse at 50% 90%,#1c3027,#101a18 75%); }
  .art-signal { color:#83c7c5; background:radial-gradient(ellipse at 50% 90%,#193032,#101a1d 75%); }
  .art-garden { color:#bcb0da; background:radial-gradient(ellipse at 50% 90%,#292737,#17171e 75%); }
</style>
