---
import type { CollectionEntry } from 'astro:content';
import { postHref } from '../../utils/paths';
import PostMeta from './PostMeta.astro';
import EditorialBlog from './EditorialBlog.astro';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const [latest, ...archive] = posts;
---
{posts.some(post=>post.data.status==='published') ? <EditorialBlog posts={posts}/> : latest ? (
  <>
    <article class="featured-post" aria-labelledby="featured-post-title">
      <div class="featured-art" aria-hidden="true">
        <span class="art-coordinate">CUADERNO / 001</span>
        <div class="note-orbit orbit-a"></div><div class="note-orbit orbit-b"></div>
        <div class="note-core"></div><div class="note-signal"></div>
        <span class="art-caption">Una idea encuentra su lugar.</span>
      </div>
      <div class="featured-text">
        <p class="eyebrow">La nota más reciente</p>
        <PostMeta post={latest} />
        <h2 id="featured-post-title"><a href={postHref(latest.data.slug)}>{latest.data.title}</a></h2>
        <p class="post-summary">{latest.data.summary}</p>
        {latest.data.tags.length > 0 && <ul class="post-tags" aria-label="Temas">{latest.data.tags.map(tag => <li>{tag}</li>)}</ul>}
        <span class="read-cue" aria-hidden="true">Abrir el cuaderno <span>↗</span></span>
      </div>
    </article>
    {archive.length > 0 && <section class="blog-archive" aria-labelledby="archive-title">
      <div class="archive-heading"><h2 id="archive-title">Otras señales.</h2><p>Para leer a tu ritmo.</p></div>
      <ol class="post-list">
        {archive.map((post, index) => <li>
          <article class="archive-post" aria-labelledby={`post-${post.data.slug}`}>
            <span class="post-number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
            <div class="archive-copy">
              <PostMeta post={post} />
              <h3 id={`post-${post.data.slug}`}><a href={postHref(post.data.slug)}>{post.data.title}</a></h3>
              <p class="post-summary">{post.data.summary}</p>
              {post.data.tags.length > 0 && <ul class="post-tags" aria-label="Temas">{post.data.tags.map(tag => <li>{tag}</li>)}</ul>}
            </div>
            <span class="archive-arrow" aria-hidden="true">↗</span>
          </article>
        </li>)}
      </ol>
    </section>}
  </>
) : (
  <div class="blog-empty">
    <p class="eyebrow">El cuaderno está abierto</p>
    <h2>La primera señal está por llegar.</h2>
    <p>Todavía no hay entradas publicadas. Este espacio guarda sitio para las próximas ideas.</p>
  </div>
)}
<style>
  .featured-post { position:relative; display:grid; overflow:hidden; margin-top:2rem; border:1px solid #385045; border-radius:1rem; background:var(--surface); }
  .featured-art { position:relative; min-height:16rem; overflow:hidden; background:radial-gradient(ellipse at 48% 85%, #234032, #0c1517 75%); }
  .art-coordinate,.art-caption { position:absolute; left:1.5rem; color:var(--muted); font:.6rem var(--font-mono); letter-spacing:.07em; }
  .art-coordinate { top:1.5rem; }.art-caption { bottom:1.5rem; }
  .note-orbit { position:absolute; width:76%; height:36%; left:12%; top:32%; border:1px solid #789a6d80; border-radius:50%; transform:rotate(-35deg); }
  .orbit-b { transform:rotate(35deg); border-color:#83c7c540; }
  .note-core { position:absolute; width:28%; aspect-ratio:1; left:36%; top:50%; transform:translateY(-50%); border-radius:50%; border:1px solid #6c8e63; background:radial-gradient(circle at 30% 25%, #7a986c, #2e4a36 35%, #101d1b 75%); box-shadow:0 0 4rem #a7e88b08; }
  .note-signal { position:absolute; left:76%; top:24%; width:.5rem; height:.5rem; border-radius:50%; background:var(--accent); box-shadow:0 0 1rem #a7e88b33; }
  .featured-text { padding:1.6rem; min-width:0; }
  .featured-text>.eyebrow { margin-bottom:1.25rem; }
  .featured-text h2 { font:400 clamp(2.2rem,4.5vw,3.3rem)/1.12 var(--font-editorial); letter-spacing:-.04em; margin:1.4rem 0 1rem; }
  h2 a,h3 a { text-decoration:none; }
  h2 a::after,h3 a::after { content:''; position:absolute; inset:0; border-radius:.8rem; }
  h2 a:focus-visible::after,h3 a:focus-visible::after { outline:2px solid var(--accent); outline-offset:-3px; }
  .post-summary { color:var(--muted); font-size:.92rem; max-width:38rem; }
  .post-tags { display:flex; flex-wrap:wrap; gap:.5rem 1rem; margin:1.2rem 0 0; padding:0; list-style:none; color:var(--cyan); font:.65rem/1.5 var(--font-mono); }
  .read-cue { display:flex; justify-content:space-between; align-items:center; border-top:1px solid #3a5144; margin-top:2rem; padding-top:1rem; color:var(--accent); font-size:.8rem; }
  .read-cue span,.archive-arrow { transition:transform var(--motion-fast) ease; }
  .featured-post:hover .read-cue span,.archive-post:hover .archive-arrow { transform:translate(2px,-2px); }
  .blog-archive { margin-top:3.5rem; }
  .archive-heading { display:flex; align-items:baseline; flex-wrap:wrap; gap:.5rem 2rem; margin-bottom:1.5rem; }
  .archive-heading h2 { font-size:1.6rem; margin:0; }.archive-heading p { color:var(--muted); font-size:.8rem; }
  .post-list { margin:0; padding:0; list-style:none; }
  .archive-post { position:relative; display:grid; grid-template-columns:1fr auto; gap:1rem; padding-block:2rem; border-top:1px solid var(--line); }
  .post-list>li:last-child { border-bottom:1px solid var(--line); }
  .post-number { display:none; color:var(--muted); font:.65rem var(--font-mono); padding-top:.4rem; }
  .archive-copy { min-width:0; }.archive-copy h3 { margin:1rem 0 .7rem; font-size:clamp(1.3rem,3vw,1.75rem); font-weight:450; letter-spacing:-.03em; line-height:1.3; }
  .archive-arrow { color:var(--accent); align-self:center; font-size:1.2rem; }
  .blog-empty { margin-top:2rem; padding:2.5rem 1.5rem; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); }
  .blog-empty h2 { max-width:35rem; }.blog-empty>p:last-child { max-width:35rem; color:var(--muted); }
  @media(min-width:45rem) {
    .featured-post { grid-template-columns:minmax(0,.9fr) minmax(0,1.2fr); }
    .featured-art { min-height:27rem; }.featured-text { padding:2.5rem; }
    .archive-post { grid-template-columns:3rem minmax(0,1fr) 2rem; gap:1.5rem; padding-block:2.25rem; }.post-number { display:block; }
  }
  @media(prefers-reduced-motion:reduce) { .featured-post:hover .read-cue span,.archive-post:hover .archive-arrow { transform:none; } }
</style>
