---
import { repositoryName, type Project } from '../data/projects';
import { projectHref } from '../utils/paths';
import ProjectArtwork from './ProjectArtwork.astro';
import TechnologyBadge from './TechnologyBadge.astro';
import ProjectDetails from './ProjectDetails.astro';

interface Props {
  project: Project;
  position: number;
}

const { project, position } = Astro.props;
---

<article id={project.id} class="project-card" aria-labelledby={`${project.id}-title`} data-project-card>
  <ProjectArtwork project={project} />
  <div class="project-body">
    <div class="project-meta">
      <p class="eyebrow">{project.category}</p>
      <span class="project-number" aria-hidden="true">{String(position).padStart(2, '0')}</span>
    </div>
    <h3 id={`${project.id}-title`}><a class="project-title-link" href={projectHref(project.id)} data-project-open={project.id}>{project.title}</a></h3>
    <p class="project-repository">{repositoryName(project)}</p>
    {project.academic && <p class="project-academic">{project.academic.institution} <span aria-hidden="true">↗</span></p>}
    {project.repositoryVisibility === 'private' && <p class="project-private">Repositorio privado</p>}
    <p class="project-summary">{project.summary}</p>
    <ul class="project-technologies" aria-label={`Tecnologías de ${project.title}`} role="list">
      {project.technologies.map(technology => <li><TechnologyBadge name={technology} /></li>)}
    </ul>
    <div class="project-links">
      <span class="project-discover" aria-hidden="true">Descubrir proyecto <span>↗</span></span>
    </div>
  </div>
</article>
<template id={`project-template-${project.id}`}><ProjectDetails project={project} /></template>

<style>
  .project-card {
    position: relative;
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: radial-gradient(ellipse at 0 0, #1f332417, transparent 60%), linear-gradient(155deg, #111d1dbb, #0b1214);
    transition: border-color 200ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .project-card:focus-within { border-color: #8ab179; }
  .project-title-link { color: inherit; text-decoration: none; }
  .project-title-link::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); z-index: 1; }
  .project-title-link:focus-visible { outline: none; }
  .project-title-link:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 4px; }
  .project-body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; padding: var(--space-3); }
  .project-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; width: 100%; }
  .project-meta .eyebrow { font-size: 0.6rem; letter-spacing: 0.06em; line-height: 1.7; }
  .project-number { color: var(--muted); font-family: var(--font-mono); font-size: 0.65rem; }
  h3 { margin-block: 1.6rem 0.6rem; font-size: clamp(1.4rem, 2.4vw, 1.8rem); font-weight: 450; letter-spacing: -0.035em; line-height: 1.2; overflow-wrap: anywhere; }
  .project-repository { margin-bottom: 1.25rem; color: var(--cyan); font-family: var(--font-mono); font-size: 0.65rem; line-height: 1.65; overflow-wrap: anywhere; }
  .project-academic, .project-private { margin: 0 0 1rem; color: var(--cyan); font-size: 0.7rem; line-height: 1.5; }
  .project-academic span { color: var(--accent); }
  .project-private { color: var(--muted); }
  .project-summary { color: var(--muted); font-size: 0.9rem; }
  .project-technologies { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 1.5rem 0; padding: 0; }
  .project-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: auto; }
  .project-discover { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 44px; border-bottom: 1px solid #668956; color: var(--text); font-size: 0.8rem; }
  .project-discover > span { color: var(--accent); transition: transform 220ms ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card:hover { transform: translateY(-3px); border-color: #506d50; box-shadow: 0 16px 35px #0003; }
    .project-card:hover .project-discover > span { transform: translate(2px, -2px); }
  }
  @media (min-width: 45rem) { .project-body { padding: var(--space-4); } }
</style>
