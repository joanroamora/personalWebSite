---
import { musicTracks } from '../data/music';
const sources = import.meta.glob<string>('../sounds/*.mp3', { eager:true, query:'?url', import:'default' });
const tracks = musicTracks.map(track => {
  const source = sources[`../sounds/${track.file}`];
  if (!source) throw new Error(`Falta la pista de música ${track.file}.`);
  return { ...track, source };
});
---
<aside class="music-widget" data-music-widget aria-label="Música del sitio" hidden>
  <details class="music-disclosure" data-music-disclosure>
    <summary aria-controls="music-panel">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 18V5l12-2v13M9 8l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="18" cy="16" rx="3" ry="2"/></svg>
      <span>Música</span><span class="music-indicator" aria-hidden="true"></span>
    </summary>
    <section id="music-panel" class="music-panel" aria-labelledby="music-heading">
      <div class="music-heading"><p class="eyebrow">La banda sonora</p><button type="button" data-music-close aria-label="Cerrar reproductor"><span aria-hidden="true">×</span></button></div>
      <h2 id="music-heading">Un poco de jazz.</h2>
      <p class="music-track" data-music-title data-no-translate dir="auto">{tracks[0].title}</p>
      <p class="music-artist" data-music-artist data-no-translate dir="auto"></p>
      <p class="music-status" data-music-status role="status" aria-live="polite"><span data-music-message="off">Solo suena si tú quieres.</span><span data-music-message="loading" hidden>Preparando la pista…</span><span data-music-message="playing" hidden>Sonando ahora.</span><span data-music-message="paused" hidden>En pausa.</span><span data-music-message="suspended" hidden>En pausa mientras juegas.</span><span data-music-message="blocked" hidden>Pulsa reproducir para continuar.</span><span data-music-message="error" hidden>No se pudo reproducir. Prueba otra pista.</span></p>
      <div class="music-actions">
        <button class="music-play" type="button" data-music-play><span data-music-play-label>Activar música</span><span data-music-pause-label hidden>Pausar música</span></button>
        <button type="button" data-music-next aria-label="Siguiente pista"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m6 5 10 7-10 7V5Zm11 0h2v14h-2z"/></svg></button>
      </div>
      <label class="music-select"><span>Elegir pista</span><select data-music-select>{tracks.map(track => <option value={track.id} data-music-source={track.source} data-music-artist-name={track.artist} data-no-translate>{track.title}</option>)}</select></label>
      <label class="music-volume"><span>Volumen</span><input type="range" data-music-volume min="0" max="100" step="1" value="25" /><output data-music-volume-output aria-hidden="true">25%</output></label>
      <audio data-music-audio preload="none"></audio>
    </section>
  </details>
</aside>
<script>import '../scripts/music';</script>
<style>
  .music-widget { position:fixed; z-index:4; inset-inline-end:max(1.25rem,env(safe-area-inset-right)); bottom:max(1rem,env(safe-area-inset-bottom)); max-width:calc(100vw - 2.5rem); }
  .music-widget[hidden], [hidden] { display:none; }
  details { position:relative; }
  summary { display:flex; align-items:center; gap:.65rem; min-height:44px; padding:.65rem .95rem; border:1px solid #4c675c; border-radius:999px; background:#111d1df5; box-shadow:0 8px 24px #0004; color:var(--text); font-size:.75rem; cursor:pointer; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  summary svg { color:var(--accent); }
  .music-indicator { width:5px; height:5px; border-radius:50%; background:var(--muted); }
  .music-widget[data-music-state="playing"] .music-indicator { background:var(--accent); box-shadow:0 0 8px #a7e88b66; }
  .music-panel { position:absolute; inset-inline-end:0; bottom:calc(100% + .65rem); width:min(21rem,calc(100vw - 2.5rem)); max-height:calc(100svh - 6rem); overflow-y:auto; overscroll-behavior:contain; padding:1.25rem; border:1px solid #425d4d; border-radius:1rem; background:#111d1df7; backdrop-filter:blur(18px); box-shadow:0 20px 70px #0009; animation:music-arrive 160ms ease-out; }
  .music-heading { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
  .music-heading .eyebrow { font-size:.6rem; }
  h2 { font:400 1.6rem/1.2 var(--font-editorial); margin:.5rem 0 1.4rem; letter-spacing:-.035em; }
  .music-track { font-size:.95rem; line-height:1.5; }
  .music-artist { min-height:1.1rem; font-size:.72rem; color:var(--cyan); }
  .music-status { min-height:2.8em; margin:.8rem 0; font-size:.7rem; color:var(--muted); }
  button, select, input { font:inherit; }
  button { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding:.65rem .8rem; border:1px solid var(--line); border-radius:.5rem; background:transparent; color:var(--text); cursor:pointer; font-size:.75rem; }
  .music-heading button { border:0; margin:-.5rem -.5rem -.5rem 0; font-size:1.5rem; }
  .music-actions { display:flex; gap:.5rem; }
  .music-play { flex:1; background:var(--accent); border-color:var(--accent); color:var(--background); font-weight:550; }
  button:hover, select:hover { border-color:var(--accent); }
  :is(button,select,input):focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .music-select { display:grid; gap:.4rem; margin-top:1.25rem; font-size:.7rem; color:var(--muted); }
  select { width:100%; min-width:0; min-height:44px; padding:.5rem; border:1px solid #4c675c; border-radius:.4rem; background:var(--background); color:var(--text); font-size:.75rem; }
  .music-volume { display:grid; grid-template-columns:auto minmax(0,1fr) 2.5rem; gap:.65rem; align-items:center; margin-top:.75rem; font-size:.7rem; color:var(--muted); }
  input { min-width:0; width:100%; min-height:44px; margin:0; accent-color:var(--accent); cursor:pointer; }
  output { text-align:end; font-family:var(--font-mono); font-size:.6rem; }
  @keyframes music-arrive { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion:reduce) { .music-panel { animation:none; } }
  @media (max-height:450px) { .music-panel { padding:.85rem; } h2 { margin-bottom:.5rem; } }
  :global(body) { padding-bottom:4.5rem; }
</style>
