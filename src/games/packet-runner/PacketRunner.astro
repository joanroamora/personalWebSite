---
import ArcadeWindow from '../shared/ArcadeWindow.astro';
import '../shared/missions.css';
const desktop=['WASD / arrows move between connected nodes. Hold to continue; release to stop at the next node.','Queue a turn before reaching a junction. Match the destination ID; a wrong destination only warns you.','Orange dashed links are slow. F diamonds are Firewall Patrols. + repairs integrity; T adds TTL.','From level 2, paired portals offer shortcuts and warned Node Down events leave another route open. Three failed packets end the run.'];
const mobile=['Use the large directional pad. Tap once for one hop, or hold to continue along linked nodes.','You can queue a turn before a junction. The envelope is you; match its destination ID.','Avoid F diamonds. Orange dashed links are congested. + repairs integrity and T adds time.','Priority Packet makes the next delivery harder for more points. Portals unlock after the first level.'];
---
<ArcadeWindow id="packet-runner" title="Packet Runner" mark="PR / ROUTE LAB" tagline="One packet. Find a way through." description="Carry an envelope through a living network. Read the paths, beat the TTL and deliver to the matching destination before the firewall finds you." desktop={desktop} mobile={mobile} fullscreen={false} guided manual="Routing handbook">
 <div slot="hud"><div class="packet-stats"><span>DESTINATION<strong data-packet-destination>A1</strong></span><span>TTL<strong data-packet-ttl>0s</strong></span><span>SCORE<strong data-packet-score>0</strong></span></div><div class="packet-meta"><label>INTEGRITY <meter data-packet-integrity min="0" max="100" value="100">100%</meter><span data-packet-hull>100%</span></label><span data-packet-deliveries>0 / 3 deliveries</span></div><p class="packet-notice" data-packet-notice></p></div>
 <Fragment slot="controls"><div class="arcade-dpad"><button type="button" data-hold="up" data-action="turn-up" aria-label="Move up">↑</button><button type="button" data-hold="left" data-action="turn-left" aria-label="Move left">←</button><button type="button" data-hold="right" data-action="turn-right" aria-label="Move right">→</button><button type="button" data-hold="down" data-action="turn-down" aria-label="Move down">↓</button></div><div class="packet-actions"><p data-packet-id>P-001 / Standard</p><p data-packet-failures>0 / 3 failed</p><button type="button" data-action="priority" aria-pressed="false">Priority Packet</button><span>Optional: next packet<br/>Less TTL, more points</span></div></Fragment>
</ArcadeWindow>
<script>import './game';</script>
<style is:global>
 .theme-packet-runner{--game-bg:#081c29;--game-accent:#a5edce}.theme-packet-runner .arcade-overlay{background:linear-gradient(145deg,#0c2635ef,#152745ed)}.theme-packet-runner .arcade-title{font-family:var(--font-mono);font-size:clamp(2.5rem,8vh,3.6rem);letter-spacing:-.07em}
 .theme-packet-runner .arcade-playfield{top:10.6rem;bottom:12rem}.packet-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;font:.62rem var(--font-mono)}.packet-stats strong{display:block;font-size:1rem;color:#a5edce;margin-top:.3rem}.packet-meta{display:flex;justify-content:space-between;gap:.8rem;margin-top:.65rem;font:.58rem var(--font-mono)}.packet-meta label{display:flex;gap:.35rem;align-items:center}.packet-meta meter{width:3rem;accent-color:#a5edce}.packet-notice{font:.64rem/1.5 var(--font-body);color:#efdcac;margin-top:.5rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
 .packet-actions{max-width:48%;font:.59rem/1.5 var(--font-mono);color:#deebdf}.packet-actions p+p{margin-top:.3rem}.packet-actions button{width:100%;margin:.6rem 0 .35rem}.packet-actions>span{font:.55rem/1.5 var(--font-body)}.packet-actions [aria-pressed="true"]{border:2px solid #a5edce}
 @media(max-height:500px) and (min-width:500px){.theme-packet-runner .arcade-playfield{inset:3.6rem 11rem .5rem}.packet-stats{grid-template-columns:1fr 1fr}.packet-meta{flex-direction:column}.packet-actions{max-width:none}.theme-packet-runner .arcade-controls{gap:.3rem}.theme-packet-runner .arcade-dpad{grid-template:repeat(3,44px)/repeat(3,44px);gap:2px}}
</style>
