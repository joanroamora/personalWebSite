<button type="button" class="launch-game" data-game-open hidden>Abrir Cadete Roa <span aria-hidden="true">↗</span></button>
<noscript><p class="no-script">Cadete Roa necesita JavaScript para jugar. Puedes consultar las instrucciones de esta página y volver al catálogo.</p></noscript>
<dialog class="cadet-window" id="cadete-window" aria-label="Cadete Roa — juego" dir="ltr" data-cadet-game>
  <div class="cadet-stage" lang="en" data-state="ready">
    <canvas class="cadet-canvas" aria-label="Three-lane 3D running course. Use the controls described below." tabindex="0"></canvas>
    <div class="cadet-vignette" aria-hidden="true"></div>
    <div class="cadet-topbar">
      <span class="cadet-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 18l8 4 8-4"/></svg> CR / FIELD TEST</span>
      <div class="cadet-window-actions"><button type="button" data-game-pause aria-label="Pause game" title="Pause game" hidden>Ⅱ</button><button type="button" data-game-close aria-label="Close game" title="Close game">✕</button></div>
    </div>
    <div class="cadet-hud" hidden>
      <div><span>DISTANCE</span><strong data-distance>0000</strong><small>m</small></div>
      <div class="cadet-tags"><span aria-hidden="true">◇</span><strong data-tokens>00</strong></div>
    </div>
    <section class="cadet-overlay" data-game-overlay aria-labelledby="cadet-screen-title">
      <div class="cadet-screen-body">
        <p class="cadet-overline" data-screen-label>AN ENDLESS FIELD RUN</p>
        <h2 id="cadet-screen-title" class="cadet-title">CADETE<br/><em>ROA</em><span class="cadet-title-dot">.</span></h2>
        <p class="cadet-screen-message" data-screen-message>Keep moving.<br/>Find your way.</p>
        <div class="cadet-results" data-game-results hidden><div><span>DISTANCE</span><strong data-result-distance>0 m</strong></div><div><span>SCORE</span><strong data-result-score>0</strong></div></div>
        <p class="cadet-best">PERSONAL BEST <span data-best>0</span></p>
        <button type="button" class="cadet-primary" data-game-start autofocus>LET'S RUN <span aria-hidden="true">→</span></button>
        <button type="button" class="cadet-secondary" data-game-restart hidden>START A NEW RUN</button>
        <p class="cadet-input-tip" data-game-tip>SWIPE TO MOVE · SWIPE UP TO JUMP<br/>OR USE ← → + SPACE</p>
        <div class="cadet-settings"><button type="button" data-game-sound aria-pressed="false">SOUND OFF</button><button type="button" data-game-quality>QUALITY AUTO</button></div>
        <p class="cadet-prototype">PLAYABLE PROTOTYPE / IN DEVELOPMENT</p>
      </div>
    </section>
    <div class="cadet-controls" aria-label="Game controls" hidden>
      <button type="button" data-game-left aria-label="Move left">←</button>
      <button type="button" data-game-jump aria-label="Jump"><svg viewBox="0 0 22 22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 18V4m-6 6 6-6 6 6"/></svg><span>JUMP</span></button>
      <button type="button" data-game-right aria-label="Move right">→</button>
    </div>
    <p class="cadet-announcement" role="status" aria-live="polite" data-game-announcement></p>
    <div class="cadet-bottom" aria-hidden="true"><span>ROA / 001</span><span>KEEP GOING ↗</span></div>
  </div>
</dialog>
<script>
  import './game';
</script>
<style>
  .launch-game { width:min(100%,25rem);display:flex;align-items:center;justify-content:space-between;gap:2rem;min-height:3.4rem;margin:1.8rem 0;padding:1rem 1.2rem;border:0;border-radius:.4rem;background:var(--accent);color:#142016;font:600 .9rem var(--font-body);cursor:pointer; }
  .launch-game:hover { background:#c0f4aa; }.launch-game:focus-visible { outline:2px solid var(--cyan);outline-offset:4px; }.launch-game[hidden] { display:none; }
  .no-script { color:var(--cyan);margin:1.5rem 0; }
  .cadet-window { --cadet-ink:#f2edcf;--cadet-lime:#d7ed9b;position:fixed;inset:0;padding:0;border:1px solid #b3bd8b4d;border-radius:1.1rem;margin:auto;width:min(27rem,calc((100dvh - 2.5rem)*.5625),calc(100vw - 2rem));height:auto;aspect-ratio:9/16;max-width:none;max-height:calc(100dvh - 2rem);overflow:hidden;color:var(--cadet-ink);background:#283d32;box-shadow:0 2rem 8rem #0009;font-family:var(--font-body); }
  .cadet-window::backdrop { background:#030a0dc7;backdrop-filter:blur(12px) saturate(.65);animation:cadet-fade 200ms ease both; }
