  .cadet-window.is-closing { animation:cadet-exit 160ms ease both; }.cadet-window.is-closing::backdrop { animation:cadet-fade 160ms ease reverse both; }
  .cadet-stage { position:relative;width:100%;height:100%;overflow:hidden;isolation:isolate;background:#859b91; }
  .cadet-canvas { width:100%;height:100%;display:block;touch-action:none;outline-offset:-4px; }
  .cadet-canvas:focus-visible { outline:2px solid var(--cadet-lime); }
  .cadet-vignette { position:absolute;inset:0;pointer-events:none;background:linear-gradient(#12281e99,transparent 32%,transparent 60%,#101d19bb); }
  .cadet-topbar { position:absolute;inset:max(.9rem,env(safe-area-inset-top)) 1rem auto;display:flex;align-items:center;justify-content:space-between;gap:.5rem;z-index:3; }
  .cadet-mark { display:flex;align-items:center;gap:.5rem;font: .56rem var(--font-mono);letter-spacing:.08em;color:#f2edcfe0; }.cadet-mark svg { width:1rem;height:1rem; }
  .cadet-window button { color:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent; }
