  [data-state="paused"] .cadet-title,[data-state="over"] .cadet-title { font-size:3.5rem;line-height:1; }
  .cadet-window [hidden] { display:none!important; }
  :global(html.cadet-open) { overflow:hidden; }
  @keyframes cadet-enter { from { opacity:0;transform:translateY(20px) scale(.97); } }
  @keyframes cadet-exit { to { opacity:0;transform:translateY(8px) scale(.98); } }
  @keyframes cadet-fade { from { opacity:0; } }
  @media(max-width:40rem),(pointer:coarse) { .cadet-window { width:100vw;height:100dvh;max-height:100dvh;aspect-ratio:auto;border:0;border-radius:0; }.cadet-title { font-size:clamp(4rem,12vh,6.3rem); }.cadet-screen-body { max-width:22rem; } }
  @media(max-height:580px) { .cadet-overlay { padding-top:4rem; }.cadet-title { font-size:3rem; }.cadet-best { margin:.8rem 0; }.cadet-screen-message { font-size:.85rem; }.cadet-input-tip { margin:.5rem 0; }.cadet-settings { margin:0; }.cadet-prototype { display:none; } }
  @media(max-height:500px) and (pointer:coarse) and (min-width:500px) { .cadet-screen-body { max-width:36rem;display:grid;grid-template-columns:1fr 1fr;gap:.4rem 2rem;align-items:center; }.cadet-overline,.cadet-title,.cadet-screen-message { grid-column:1; }.cadet-title { margin:.3rem 0; }.cadet-best,.cadet-primary,.cadet-secondary,.cadet-input-tip,.cadet-settings,.cadet-results { grid-column:2;margin:0; }.cadet-best { grid-row:1; }.cadet-primary { grid-row:2; }.cadet-secondary { grid-row:3; }.cadet-input-tip { grid-row:4; }.cadet-settings { grid-row:5; }.cadet-results { grid-column:1; }.cadet-hud { top:4rem; }.cadet-controls { width:18rem;left:auto;bottom:1.7rem; }.cadet-controls button { min-height:3rem; } }
