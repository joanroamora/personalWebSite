  .cadet-overlay { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:4.5rem 1.7rem 2.1rem;background:linear-gradient(150deg,#15352be8,#15352bb0 50%,#192e26c4);overflow:auto;overscroll-behavior:contain; }
  .cadet-screen-body { width:100%;max-width:22rem;margin:auto; }
  .cadet-overline { font:.6rem var(--font-mono);letter-spacing:.18em;color:#c9d4b0; }
  .cadet-title { font-family:Impact,'Arial Black',var(--font-body);font-weight:900;font-size:clamp(3rem,10vh,5.5rem);line-height:.88;letter-spacing:-.035em;margin:1.2rem 0; }
  .cadet-title em { font-style:normal;color:var(--cadet-lime); }.cadet-title-dot { color:#e2ac7d; }
