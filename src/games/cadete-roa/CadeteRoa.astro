  .cadet-primary { border:0;border-radius:.28rem;min-height:3.5rem;padding:1rem 1.2rem;width:100%;display:flex;align-items:center;justify-content:space-between;background:var(--cadet-lime);color:#253927!important;font:700 .8rem var(--font-body);letter-spacing:.04em;transition:background 160ms,transform 160ms; }
  .cadet-primary:hover { background:#eaf7bf;transform:translateY(-2px); }
