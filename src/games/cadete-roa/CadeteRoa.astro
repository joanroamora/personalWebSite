  .cadet-controls button { display:flex;align-items:center;justify-content:center;gap:.3rem;min-height:3.8rem;border:1px solid #e6ecc78c;background:#1e382dbd;backdrop-filter:blur(5px);border-radius:.6rem;font-size:1.5rem;user-select:none; }
  .cadet-controls button[data-game-jump] { border-color:#d7ed9b99;background:#d7ed9b;color:#253927; }.cadet-controls button:active { transform:scale(.96); }.cadet-controls button svg { width:1.2rem;height:1.2rem; }.cadet-controls button span { font:700 .65rem var(--font-body); }
  .cadet-bottom { position:absolute;inset:auto 1rem max(.65rem,env(safe-area-inset-bottom));display:flex;justify-content:space-between;color:#dae2bf99;font:.45rem var(--font-mono);letter-spacing:.12em;pointer-events:none; }
