---
import ArcadeWindow from '../shared/ArcadeWindow.astro';
const desktop=['WASD or arrows: move the trolley and raise or lower the hook.','Space: Pick Up a container when the hook is aligned with its roof. Raise it before travelling.','Match both the container ID and numbered slot. Lower to wagon height, stop, then press Space to Release.','Q / E: explore yard sections. Moving the trolley returns the camera to follow mode.','Start with 3 orders. Later operations add cargo, longer routes and tighter alignment. Wrong loads cost 8 seconds; pick them up again to correct them. P or Escape: pause.'];
const mobile=['Hold the direction buttons to move the trolley and raise or lower the hook. You can hold two directions together.','Align with a container roof, tap Pick Up, then raise the load before moving across the yard.','Use the separate View buttons or yard slider to inspect the train. Moving sideways follows the trolley.','Match the cargo ID, symbol and slot number. Lower into the wagon, stop and tap Release.','Start with 3 orders. Correct mistakes by picking up the container again. A free drop costs 6 seconds and returns cargo to its staging pad. Pause whenever you need.'];
---
<ArcadeWindow id="rail-crane" title="Rail Crane" mark="RC / EAST YARD OPERATIONS" tagline="A long train. A short window." description="The departure board is ticking. Work the gantry, steady the load and put every container in its numbered place. Rail Crane is the working title." desktop={desktop} mobile={mobile}>
  <div slot="hud">
    <div class="arcade-stats"><span>SCORE <strong data-crane-score>00000</strong></span><span>TIME <strong data-crane-time>3:00</strong></span><span>ORDERS <strong data-crane-count>0/3</strong></span></div>
    <p class="crane-order" data-crane-order aria-live="polite">Load blue container C-12 ◆ into slot 02.</p>
    <p class="arcade-warning" data-crane-warning></p><span class="crane-streak" data-crane-streak>OP 01 · STREAK ×0</span>
  </div>
  <Fragment slot="controls"><div class="arcade-dpad" role="group" aria-label="Crane movement"><button type="button" data-hold="up" aria-label="Raise hook">↑</button><button type="button" data-hold="left" aria-label="Move trolley left">←</button><button type="button" data-hold="right" aria-label="Move trolley right">→</button><button type="button" data-hold="down" aria-label="Lower hook">↓</button></div><div class="arcade-control-actions"><span class="crane-hook" data-crane-held>HOOK / EMPTY</span><button type="button" class="context-action" data-action="grip">Pick Up / Space</button><button type="button" data-action="view-left" aria-label="View previous yard section">◀ View</button><button type="button" data-action="view-right" aria-label="View next yard section">View ▶</button><label class="arcade-camera"><span data-crane-bay>VIEW 01 / 06</span><input type="range" data-camera min="0" max="100" step="1" value="0" aria-label="Explore the rail yard" /></label></div></Fragment>
</ArcadeWindow>
<script>import './game';</script>
<style is:global>
  .theme-rail-crane .arcade-playfield{top:10.5rem;bottom:11.3rem}.theme-rail-crane .crane-order{margin:.55rem 0 0;color:#f8e1b5;font:.65rem/1.5 var(--font-mono)}.theme-rail-crane .arcade-warning{font-size:.53rem;line-height:1.4;margin-top:.35rem;min-height:2.8em}.crane-hook{grid-column:1/-1;font:.52rem var(--font-mono);color:#d1dbd8}.crane-streak{color:#b8cec6;font:.5rem var(--font-mono)}.theme-rail-crane .arcade-controls{display:grid;grid-template-columns:8.5rem minmax(0,1fr);gap:.5rem}.theme-rail-crane .arcade-control-actions{width:100%}.theme-rail-crane .arcade-camera span{min-width:3rem;font-size:.45rem}.theme-rail-crane [data-aligned="true"]{box-shadow:0 0 0 2px #e3f5ac}
  @media(max-height:500px) and (min-width:500px){.theme-rail-crane .arcade-playfield{inset:3.6rem 11rem .5rem}.theme-rail-crane .arcade-controls{display:flex;gap:.4rem}.theme-rail-crane .arcade-dpad{grid-template:repeat(2,2.75rem)/repeat(3,2.75rem)}.theme-rail-crane .arcade-dpad button:nth-child(1){grid-area:1/2}.theme-rail-crane .arcade-dpad button:nth-child(4){grid-area:2/2}.theme-rail-crane .arcade-control-actions{width:100%}.theme-rail-crane .crane-hook{display:none}}
</style>
