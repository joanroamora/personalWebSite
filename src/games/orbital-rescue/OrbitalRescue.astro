---
import ArcadeWindow from '../shared/ArcadeWindow.astro';
import '../shared/missions.css';
const desktop=['A / D or left / right rotate. W / Up applies thrust. S / Down brakes with manoeuvring thrusters.','Launch with Thrust. Coast toward a beacon, then Brake below 9 m/s and stay within the rescue ring for 1.4 seconds.','Return to Station with up to two passengers. Slow below 11 m/s and point the nose upward; docking then happens automatically.','Fuel and hull refill when docked. The first mission has no oxygen deadline or debris. Later missions introduce both.'];
const mobile=['Hold Turn Left / Right with Thrust to steer. Hold Brake to reduce speed. Multiple fingers work together.','Use Next Beacon and the edge arrows to locate astronauts. Brake inside their rescue ring; pickup is automatic after a short hold.','Two passengers fill the cabin. Return to Station, slow down and point upward to dock automatically.','Launch again when refuelling and repairs finish. Emergency reserve powers thrusters after main fuel runs out.'];
---
<ArcadeWindow id="orbital-rescue" title="Orbital Rescue" mark="OR / BEACON SERVICE" tagline="Bring somebody home." description="A small rescue ship, real inertia and a quiet patch of space. Find the beacons, slow down for pickup and return your passengers safely to the station." desktop={desktop} mobile={mobile} fullscreen={false} guided manual="Rescue flight handbook">
 <div slot="hud"><div class="rescue-stats"><span>FUEL<strong data-rescue-fuel>100%</strong></span><span>HULL<strong data-rescue-hull>100%</strong></span><span>PASSENGERS<strong data-rescue-passengers>0 / 2</strong></span><span>RESCUED<strong data-rescue-count>0 / 2</strong></span><span>SPEED<strong data-rescue-speed>0 m/s</strong></span><span>SCORE<strong data-rescue-score>0</strong></span></div><p class="rescue-target" data-rescue-target>Mission objective: rescue 2 astronauts</p><p class="rescue-notice" data-rescue-notice></p><progress data-rescue-progress max="1" value="0" aria-label="Rescue or docking hold progress"></progress></div>
 <Fragment slot="controls"><div class="rescue-flight-controls"><button type="button" data-hold="left">↶ Turn Left</button><button type="button" data-hold="right">Turn Right ↷</button><button type="button" data-hold="down">Brake</button><button type="button" data-hold="up">Thrust ↑</button></div><div class="rescue-context-controls"><button type="button" data-action="next-beacon">Next Beacon</button><button type="button" data-action="context">Launch</button></div></Fragment>
</ArcadeWindow>
<script>import './game';</script>
<style is:global>
 .theme-orbital-rescue{--game-bg:#0c192a;--game-accent:#b5dbf6}.theme-orbital-rescue .arcade-overlay{background:linear-gradient(150deg,#0d2334ef,#1d2542ed)}.theme-orbital-rescue .arcade-title{font-size:clamp(2.5rem,8vh,3.7rem)}
 /* The HUD can wrap differently across OS fonts. Let its real height reserve
    space instead of positioning the canvas below a guessed rem offset. */
 .arcade-window.theme-orbital-rescue .arcade-stage{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;gap:.5rem;padding:max(4.2rem,calc(env(safe-area-inset-top) + 3.4rem)) 1rem calc(env(safe-area-inset-bottom) + 3rem)}
 .arcade-window.theme-orbital-rescue :is(.arcade-hud,.arcade-playfield,.arcade-controls){position:static;inset:auto;width:auto;min-width:0}
 .arcade-window.theme-orbital-rescue .arcade-hud{grid-row:1}.arcade-window.theme-orbital-rescue .arcade-playfield{grid-row:2;min-height:0;overflow:hidden}.arcade-window.theme-orbital-rescue .arcade-controls{grid-row:3}
 .rescue-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;font:.58rem/1.25 var(--font-mono)}.rescue-stats strong{display:block;color:#b5dbf6;font-size:.9rem;line-height:1.2;margin-top:.25rem}.rescue-target,.rescue-notice{font:.61rem/1.45 var(--font-body);margin-top:.45rem;color:#d4e3db;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.rescue-notice{color:#ffe1aa}.theme-orbital-rescue [data-rescue-progress]{display:block;width:100%;height:.35rem;margin-top:.2rem;accent-color:#b4e5cb}
 .theme-orbital-rescue .arcade-controls{display:grid;gap:.5rem;grid-template-columns:1fr}.rescue-flight-controls{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.rescue-context-controls{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.theme-orbital-rescue .arcade-controls button{min-height:44px;font-size:.65rem}.theme-orbital-rescue [data-hold="up"]{background:#badfd3;color:#152934}
 @media(max-height:500px) and (min-width:500px){.rescue-stats{grid-template-columns:1fr 1fr;gap:.4rem}.rescue-stats strong{font-size:.75rem}.theme-orbital-rescue .arcade-controls{align-content:center}.rescue-context-controls{grid-template-columns:1fr}.rescue-target,.rescue-notice{font-size:.55rem}}
 @media(max-height:500px) and (min-width:500px) and (pointer:coarse){
  .arcade-window.theme-orbital-rescue .arcade-stage{grid-template-columns:9rem minmax(0,1fr) 9rem;grid-template-rows:minmax(0,1fr);padding-top:max(3.6rem,calc(env(safe-area-inset-top) + 3rem))}
  .arcade-window.theme-orbital-rescue .arcade-hud{grid-area:1/1;align-self:start}.arcade-window.theme-orbital-rescue .arcade-playfield{grid-area:1/2}.arcade-window.theme-orbital-rescue .arcade-controls{grid-area:1/3;align-self:center}
 }
</style>
